[
    {
        "stepTitle": "桥接模式",
        "items": [
            {
                "type": "radio",
                "field": "wizard_mode",
                "label": "要让哪些设备变成 AirPlay 音箱",
                "initValue": "upnp",
                "options": [
                    { "label": "DLNA / UPnP 音响（含 Sonos、Heos，推荐）", "value": "upnp" },
                    { "label": "Chromecast / Google Cast 设备", "value": "cast" },
                    { "label": "两种都启用（同时运行 airupnp 与 aircast）", "value": "both" }
                ],
                "helpText": "切换模式会重启桥接程序，正在播放的 AirPlay 会话会中断。"
            }
        ]
    },
    {
        "stepTitle": "AirPlay 名称",
        "items": [
            {
                "type": "text",
                "field": "wizard_name_suffix",
                "label": "AirPlay 名称后缀",
                "initValue": "+",
                "helpText": "拼在音响原名之后。留空表示与原名完全一致。",
                "rules": [
                    { "pattern": "^[^%]{0,20}$", "message": "后缀最多 20 个字符，且不能包含百分号 %" }
                ]
            }
        ]
    },
    {
        "stepTitle": "播放延迟",
        "items": [
            {
                "type": "radio",
                "field": "wizard_latency",
                "label": "延迟 / 缓冲",
                "initValue": "500:0",
                "options": [
                    { "label": "低延迟（推荐，500:0）", "value": "500:0" },
                    { "label": "跟随 AirPlay 宣告（0:0）", "value": "0:0" },
                    { "label": "Sonos / Heos（1000:2000）", "value": "1000:2000" }
                ],
                "helpText": "AirConnect 要先攒一段 AirPlay 音频才转发给音箱，攒得越多、暂停/恢复/拖进度条的延迟越大。实测：选 0:0 时它会照用 iOS 宣告的 1750ms，暂停恢复各慢约 1.75 秒；500:0 是上游文档推荐的抗抖动下限。Sonos / Heos 必须用 1000:2000，否则会卡顿。"
            }
        ]
    },
    {
        "stepTitle": "日志级别",
        "items": [
            {
                "type": "radio",
                "field": "wizard_log_level",
                "label": "日志详细程度",
                "initValue": "info",
                "options": [
                    { "label": "常规（推荐）", "value": "info" },
                    { "label": "详细（排查问题用）", "value": "debug" },
                    { "label": "仅警告与错误", "value": "warn" }
                ]
            }
        ]
    }
]
